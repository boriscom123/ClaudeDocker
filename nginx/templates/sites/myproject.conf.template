# MyProject — форма обратной связи. Апстрим `myproject` резолвится по алиасу
# compose-проекта на сети claude-net (порт 3003), к ней подключён общий nginx.
server {
    listen 80;
    server_name ${MP_DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name ${MP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${MP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MP_DOMAIN}/privkey.pem;

    location / {
        set $mp_upstream myproject:3003;
        proxy_pass http://$mp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
